{
  "name": "order-tracker",
  "version": "0.1.0",
  "description": "Track online orders by reading order emails over IMAP",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "imapflow": "^1.0.190",
    "mailparser": "^3.7.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "productName": "Summit Order Tracking",
  "build": {
  "appId": "com.offthemoon.summitordertracking",   
  "directories": { "output": "dist", "buildResources": "resources" },
  "files": ["out/**/*", "resources/**/*"],       
  "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.productivity" },
  "win": { "target": "nsis" },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
}
  
}
